# Server-only secrets. Copy into .env.local; never use a VITE_ prefix.
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GROQ_MODEL=openai/gpt-oss-20b

# Natural voice download (server-side only; never prefix with VITE_)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Gemini is preferred when both providers are configured.
GEMINI_API_KEY=
