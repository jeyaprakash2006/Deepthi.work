+    #[test]
+    fn question_paper_opens_as_editable_a4_document() {
+        let mut session = crate::Session::new(Document::new());
+        session.run("file.new", &serde_json::json!({"template": "question-paper"})).unwrap();
+        assert_eq!(session.doc.body.len(), 25);
+        assert!((session.doc.last_section.page_w - 595.28).abs() < 0.01);
+        assert_eq!(session.export_layout().pages.len(), 1);
+        let bytes = wordcraft_docx::write(&session.doc).unwrap();
+        let reopened = wordcraft_docx::read(&bytes).unwrap();
+        assert_eq!(reopened.word_count(), session.doc.word_count());
+        assert_eq!(reopened.body.len(), session.doc.body.len());
+        session.run("text.insert", &serde_json::json!({"text": "Test School "})).unwrap();
+        assert!(session.doc.word_count() > question_paper().word_count());
+    }
