+/// An editable A4 examination paper, opened directly by File > New.
+pub fn question_paper() -> Document {
+    let mut d = Document::new();
+    d.last_section.page_w = 595.28;
+    d.last_section.page_h = 841.89;
+    d.last_section.margin_top = 42.0;
+    d.last_section.margin_bottom = 42.0;
+    d.last_section.margin_left = 48.0;
+    d.last_section.margin_right = 48.0;
+    let line = |text: &str, heading: bool, centered: bool| {
+        let mut p =
+            Paragraph::with_text(text, CharProps { size: Some(if heading { 12.0 } else { 11.0 }), bold: Some(heading), ..Default::default() });
+        p.props.align = Some(if centered { Align::Center } else { Align::Left });
+        p.props.space_after = Some(7.0);
+        p.props.keep_next = Some(heading);
+        para_block(p)
+    };
+    d.body = vec![
+        line("[SCHOOL / COLLEGE NAME]", true, true),
+        line("[Department / Class]", false, true),
+        line("[EXAMINATION TITLE]", true, true),
+        line("[Course code] - [Subject name]", true, true),
+        line("Name: ____________________    Register no.: ____________________", false, false),
+        line("Semester / Class: __________    Date: __________", false, false),
+        line("Time: 3 hours                                      Maximum marks: 100", true, false),
+        line("Instructions: Answer all questions. Write clearly and show your working.", false, false),
+        line("PART A - Short answers (10 x 2 = 20 marks)", true, true),
+    ];
+    for n in 1..=10 {
+        d.body.push(line(&format!("{n}. [Enter a short-answer question.]"), false, false));
+    }
+    d.body.push(line("PART B - Detailed answers (5 x 16 = 80 marks)", true, true));
+    for n in 11..=15 {
+        d.body.push(line(&format!("{n}. [Enter a detailed-answer question.]"), false, false));
+    }
+    d
+}
